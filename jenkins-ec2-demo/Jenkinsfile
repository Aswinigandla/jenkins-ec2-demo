

pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo 'Code downloaded from GitHub'
            }
        }

        stage('Verify Application') {
            steps {
                dir('jenkins-ec2-demo') {
                    bat 'dir'
                    bat 'if not exist index.html exit /b 1'
                    bat 'if not exist README.md exit /b 1'
                    echo 'Application files verified successfully'
                }
            }
        }

        stage('Package Application') {
            steps {
                archiveArtifacts artifacts: 'jenkins-ec2-demo/index.html,jenkins-ec2-demo/README.md',
                                 fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Application is ready!'
        }
        failure {
            echo 'FAILED: Check Console Output.'
        }
    }
}
